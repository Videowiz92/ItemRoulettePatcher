<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the real RussianTextTranslator.cs against tiny stubs so the translation table can be tested
       without the game. Run with: dotnet run (from this folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\ItemRoulettePatcher\Patches\RussianTextTranslator.cs" Link="RussianTextTranslator.cs" />
  </ItemGroup>

</Project>
